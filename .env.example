# Environment Configuration for Diabetes Prediction System
# Copy this to .env and configure with your actual values

# ============================================
# Grafana Cloud Configuration (Monitoring)
# ============================================

# Enable/disable Loki logging
LOKI_ENABLED=false

# Grafana Cloud Loki Settings (when LOKI_ENABLED=true)
# Get these from: https://grafana.com/orgs/YOUR-ORG
LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
LOKI_USERNAME=your-instance-id
LOKI_API_KEY=your-api-key-with-write-permissions

# ============================================
# Application Settings
# ============================================

APP_NAME=diabetes-prediction
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================
# Metrics Configuration
# ============================================

METRICS_RETENTION_HOURS=24
TRACK_USER_SESSIONS=true

# ============================================
# Notes
# ============================================
# - For Grafana Cloud setup, see GRAFANA-CLOUD-SETUP.md
# - API Key must have "MetricsPublisher" or "Admin" role (not read-only)
# - Keep .env file secure and never commit to git
